<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into main/AndroidManifest.xml only for the origin flavor (see
     build.gradle's SUPPORTS_SELF_UPDATE). REQUEST_INSTALL_PACKAGES and the
     FileProvider below back the in-app "check for update" download+install
     flow in UpdateChecker; playstore never gets either, since Play-
     distributed apps must not self-update from outside Play. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingLeanbackLauncher">

    <!-- This flavor overlay intentionally adds only update support. The
         LEANBACK_LAUNCHER activity is declared in src/main/AndroidManifest.xml;
         suppress the detector's per-file false positive for this overlay. -->

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>
